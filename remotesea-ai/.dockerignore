.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
# Generated by the Dataset Builder — regenerated at runtime, not something
# a fresh image needs a stale local copy of (same reasoning as .gitignore).
datasets/
# Real secrets (AI_SERVICE_SECRET, DATABASE_URL passwords, API keys) —
# never bake these into an image layer, where they'd sit indefinitely even
# if a later layer "removes" the file, and could leak if the image is ever
# pushed to a registry. Supply at container *runtime* instead: docker-
# compose.yml's `env_file: .env` already does this correctly; a plain
# `docker run` needs `--env-file .env` (or explicit `-e` flags) the same
# way — never `COPY .env` or letting a build context without this file
# include it implicitly.
.env
.env.*
!.env.example
