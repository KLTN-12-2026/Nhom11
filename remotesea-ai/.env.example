# AI Service's own database — deliberately separate from remotesea-api's
# Supabase instance (see README: "AI Service phải là một service độc lập").
# docker-compose.yml's `postgres` service matches this by default.
DATABASE_URL=postgresql+asyncpg://ai_service:ai_service@localhost:5434/remotesea_ai

# Shared-secret auth for NestJS -> AI Service calls (server-to-server, not a
# user-facing token) — see app/core/security.py. NestJS must send this same
# value as `Authorization: Bearer <AI_SERVICE_SECRET>`.
AI_SERVICE_SECRET=change-me-to-a-random-secret

# AiModelProvider selection — OLLAMA is the only implementation in Phase 1+2
# (see app/providers/factory.py); the abstraction leaves room for a VLLM
# provider later without changing app/services/inference_service.py.
AI_MODEL_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

PORT=8000
