# AI Service's own database — deliberately separate from remotesea-api's
# Supabase instance (see README: "AI Service phải là một service độc lập").
# docker-compose.yml's `postgres` service matches this by default.
DATABASE_URL=postgresql+asyncpg://ai_service:ai_service@localhost:5434/remotesea_ai

# Shared-secret auth for NestJS -> AI Service calls (server-to-server, not a
# user-facing token) — see app/infrastructure/security.py. NestJS must send
# this same value as `Authorization: Bearer <AI_SERVICE_SECRET>` on the
# legacy endpoints, and as the HS256 signing key for orchestrator context
# tokens on the new ones (require_orchestrator_context) — must match
# remotesea-api's AI_SERVICE_SECRET exactly, same value on both services.
AI_SERVICE_SECRET=change-me-to-a-random-secret

# AiModelProvider selection — see
# app/infrastructure/providers/llm/factory.py. OLLAMA (default) is
# self-hosted and needs no API key; ANTHROPIC/GEMINI/CLOUDFLARE are opt-in
# cloud alternatives, each needing their own credentials below. MOCK is a
# zero-cost/zero-network provider for tests and for verifying orchestrator
# plumbing without a real model. AI_PROVIDER (the old name) is still
# accepted as a fallback if this is unset, for environments not yet
# migrated to AI_MODEL_PROVIDER.
AI_MODEL_PROVIDER=OLLAMA
# Shared model id, used by whichever provider above doesn't have its own
# <VENDOR>_MODEL var (currently ANTHROPIC/GEMINI/MOCK) — also the fallback
# for OLLAMA_MODEL/CLOUDFLARE_MODEL below when those are unset. Its meaning
# depends on the active provider: an Ollama tag, an Anthropic model id, a
# Gemini model id, or a Cloudflare Workers AI model id.
AI_MODEL=qwen2.5:3b-instruct
# Low, not each provider's own default (Ollama/Anthropic/Gemini/Cloudflare
# all default well above this) — every call this service makes is a
# structured business decision, not creative text, so consistency matters
# more than variety.
AI_TEMPERATURE=0.2

# --- AI_MODEL_PROVIDER=OLLAMA -----------------------------------------------
# Only read by OllamaProvider — not needed (and not required) when a
# different provider is active, e.g. production on AI_MODEL_PROVIDER=cloudflare.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama tag actually served — falls back to AI_MODEL above when unset.
# OLLAMA_MODEL=qwen2.5:3b-instruct

# --- AI_MODEL_PROVIDER=ANTHROPIC --------------------------------------------
# ANTHROPIC_API_KEY=

# --- AI_MODEL_PROVIDER=GEMINI ------------------------------------------------
# GEMINI_API_KEY=

# --- AI_MODEL_PROVIDER=CLOUDFLARE -------------------------------------------
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN are both required together —
# Workers AI auth is account-scoped, not a single global key.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Cloudflare Workers AI model id — falls back to AI_MODEL above when unset.
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional override for the tool-selection/RAG-necessity classification
# call only (a much simpler decision than the final answer) — leave unset
# to use AI_MODEL for everything. Live-tested tradeoff, not a free win: a
# smaller model is faster but can misjudge needsKnowledge (see README) —
# only set this if you've verified it against your own real questions.
# AI_CLASSIFICATION_MODEL=

# Where this service calls remotesea-api back on (Tool Calling, and the
# orchestrator health check's round-trip proof) — never queries
# remotesea-api's database directly.
REMOTESEA_API_BASE_URL=http://localhost:4000

# RAG's own database — a second database on the same Postgres server (not a
# schema inside remotesea_ai), so knowledge-base storage stays independent
# from the AI Learning Loop's tables. Holds RagDocument + the slim RagChunk
# metadata/content rows used for full-text search — chunk *vectors* live in
# Qdrant instead (QDRANT_* below), not here, so this DB no longer needs the
# pgvector extension for RAG's own sake. Requires `ollama pull
# nomic-embed-text` locally when EMBEDDING_PROVIDER=OLLAMA.
RAG_DATABASE_URL=postgresql+asyncpg://ai_service:ai_service@localhost:5434/remotesea_rag
EMBEDDING_PROVIDER=OLLAMA
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# RAG chunk vector storage/search — see app/infrastructure/qdrant_client.py.
# A Qdrant Cloud cluster URL (or a self-hosted Qdrant's URL) — required, not
# optional, since RAG's vector search depends on it. The collection is
# created automatically on first ingest if it doesn't exist yet.
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_API_KEY=change-me-to-a-real-qdrant-api-key
QDRANT_COLLECTION_NAME=remotesea_rag_chunks

PORT=8000
