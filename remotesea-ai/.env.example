# AI Service's own database — deliberately separate from remotesea-api's
# Supabase instance (see README: "AI Service phải là một service độc lập").
# docker-compose.yml's `postgres` service matches this by default.
DATABASE_URL=postgresql+asyncpg://ai_service:ai_service@localhost:5434/remotesea_ai

# Shared-secret auth for NestJS -> AI Service calls (server-to-server, not a
# user-facing token) — see app/core/security.py. NestJS must send this same
# value as `Authorization: Bearer <AI_SERVICE_SECRET>` on the legacy
# endpoints, and as the HS256 signing key for orchestrator context tokens on
# the new ones (require_orchestrator_context) — must match remotesea-api's
# AI_SERVICE_SECRET exactly, same value on both services.
AI_SERVICE_SECRET=change-me-to-a-random-secret

# AiModelProvider selection — see app/providers/factory.py. MOCK is a
# zero-cost/zero-GPU provider for tests and for verifying orchestrator
# plumbing without a real model.
AI_MODEL_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Where this service calls remotesea-api back on (Tool Calling, and the
# orchestrator health check's round-trip proof) — never queries
# remotesea-api's database directly.
REMOTESEA_API_BASE_URL=http://localhost:4000

# RAG's own database — a second database on the same Postgres server (not a
# schema inside remotesea_ai), so knowledge-base storage stays independent
# from the AI Learning Loop's tables. Needs `CREATE EXTENSION vector;` run
# once inside it (docker-compose.yml's postgres image already bundles the
# extension — see that file's comment). Requires `ollama pull
# nomic-embed-text` locally when EMBEDDING_PROVIDER=OLLAMA.
RAG_DATABASE_URL=postgresql+asyncpg://ai_service:ai_service@localhost:5434/remotesea_rag
EMBEDDING_PROVIDER=OLLAMA
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

PORT=8000
