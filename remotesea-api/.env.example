# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://remotesea:remotesea_password@localhost:5432/remotesea_dev

# ─── Auth (JWT replaces NextAuth session) ─────────────────────────────────────
AUTH_SECRET=your-32-char-secret-change-in-production
JWT_EXPIRES_IN=30d

# OAuth Providers (optional — feature degrades gracefully when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=RemoteSEA <noreply@remotesea.io>

# ─── File Storage (S3-compatible) ─────────────────────────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
CDN_URL=

# ─── Stripe (job posting payments) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=
