# Local-only defaults for `docker compose`'s own variable substitution.
#
# Compose reads a project .env file to resolve ${VAR:-default} in
# docker-compose.yml — separately from `env_file: .env`, which injects
# variables into the containers themselves. This repo's real `.env` holds
# live secrets (including a DATABASE_URL that may point at a remote/prod
# database), so it must never be the file Compose uses for substitution —
# otherwise `docker compose up` silently targets that remote database
# instead of the local `postgres` container. Always run Compose with
# `--env-file .env.docker` (see the `docker:*` npm scripts) so these
# dev-only values are the ones substituted.
POSTGRES_USER=remotesea
POSTGRES_PASSWORD=remotesea_password
POSTGRES_DB=remotesea_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://remotesea:remotesea_password@postgres:5432/remotesea_dev
PORT=4000
